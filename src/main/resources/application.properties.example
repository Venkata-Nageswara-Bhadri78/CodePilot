spring.application.name=copilot

# Databases
spring.datasource.url=jdbc:mysql://localhost:3306/copilot
spring.datasource.username=<your-sql-username>
spring.datasource.password=<your-sql-password>

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

logging.level.org.springframework.security=DEBUG

# JWT Configuration
app.jwt.secret=<enter-your-jwt-configuration-secret-key-here>
app.jwt.expiration=86400000

# Swagger UI
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

# Email Configuration

# SMTP Server (Gmail)
spring.mail.host=smtp.gmail.com
spring.mail.port=587

# Gmail account used to send emails
spring.mail.username=<your-email@gmail.com>

# Gmail App Password (NOT your Gmail login password)
# Generate from: Google Account → Security → App Passwords
spring.mail.password=<your-16-character-app-password>

# SMTP Security
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Timeouts (milliseconds)
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# Sender Information
app.mail.from=<your-email@gmail.com>
app.mail.sender-name=AI Copilot

# MinIO Configuration
storage.provider=minio
storage.endpoint=http://localhost:9000
storage.access-key=minioadmin
storage.secret-key=minioadmin
storage.bucket-name=copilot-resumes
storage.auto-create-bucket=true

# Resume Configuration
resume.max-resume-count=10
resume.max-file-size-mb=5

# Resume Parsing Configuration
resume.parsing.max-attempts=3
resume.parsing.max-text-length=200000
resume.parsing.parser-version=v1

# Internal Service-To-Service API
# Callers of /api/v1/internal/** must send this secret in the X-Internal-Api-Key header.
internal.api.enabled=true
internal.api.key=<generate-a-long-random-internal-service-key>

# Google AI Studio API Key (or OpenAI API Key / Custom Agentic AI URL)
spring.ai.openai.api-key=${GEMINI_API_KEY:THIS_IS_EXAMPLE_KEY}
spring.ai.openai.base-url=https://generativelanguage.googleapis.com/v1beta/openai/
spring.ai.openai.chat.options.model=gemini-flash-latest
spring.ai.openai.chat.options.temperature=0.7

# Application AI Custom Settings
app.ai.provider=gemini
app.ai.default-model=gemini-flash-latest
app.ai.streaming-timeout-seconds=60
app.ai.agentic-server-url=http://localhost:8000/v1

# Auth Redis (distributed rate limits / mail cooldown / login backoff). Off by default.
app.auth.redis.enabled=false
app.auth.redis.host=localhost
app.auth.redis.port=6379
app.auth.redis.database=0
app.auth.redis.timeout-ms=2000
app.auth.redis.key-prefix=auth